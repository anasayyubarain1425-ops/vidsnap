# ===== VideoGrabTool Environment Variables =====
# Copy this file to .env and fill in the values.
# For Railway: add these in Project Settings -> Variables.

# --- Required ---

# PostgreSQL connection string (from Neon Cloud)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-frosty-scene-awdx8uey.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Session encryption secret (any long random string, min 32 chars)
SESSION_SECRET="replace-with-a-long-random-string"

# Public app URL (your live domain)
NEXT_PUBLIC_APP_URL="https://videograbtool.com"

# --- Lemon Squeezy (payments) ---

# API key from Lemon Squeezy Settings -> API
LEMONSQUEEZY_API_KEY=""

# Store ID from Lemon Squeezy Settings -> Store
LEMONSQUEEZY_STORE_ID=""

# Variant ID of your Pro plan product
LEMONSQUEEZY_VARIANT_ID=""

# Webhook secret (create one in Lemon Squeezy webhook settings)
LEMONSQUEEZY_WEBHOOK_SECRET=""

# --- Admin ---

# Secret for admin API calls
ADMIN_SECRET="replace-with-a-long-random-string"

# Admin email (gets admin privileges in account page)
ADMIN_EMAIL="you@example.com"

# --- Optional (can be left empty) ---
# Paddle / Stripe are not used. Leave blank.
PADDLE_API_KEY=""
PADDLE_ENVIRONMENT=""
PADDLE_PRICE_ID=""
PADDLE_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
